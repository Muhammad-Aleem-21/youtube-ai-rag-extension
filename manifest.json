{
    "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
   },
  "manifest_version": 3,

  "name": "YouTube AI Assistant",

  "version": "1.0.0",

  "description": "Ask questions about the YouTube video you are watching.",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube-ai-rag-extension-production.up.railway.app/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "YouTube AI Assistant",
    "default_popup": "popup/popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],

      "js": [
        "content/content.js"
      ],

      "css": [
        "content/content.css"
      ],

      "run_at": "document_idle"
    }
  ]
}